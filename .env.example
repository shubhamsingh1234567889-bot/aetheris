# Copy to .env for local development. NEVER prefix secrets with VITE_ -
# anything starting with VITE_ is bundled into the browser JavaScript and is public.
# All keys below are read by the Express server only.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Browser origins allowed to call the API cross-origin (comma-separated). Empty = same-origin only.
# With `npm run dev` the Vite proxy makes this unnecessary.
CORS_ORIGINS=

# Per-IP limits (requests/minute): general, and for expensive endpoints (search, greenwash, import)
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_HEAVY_PER_MIN=20

# ---- Integrations (optional) ----
# TinyFish web search (read automatically by the @tiny-fish/sdk)
TINYFISH_API_KEY=
# World Air Quality Index token (https://aqicn.org/data-platform/token/) - falls back to keyless Open-Meteo
WAQI_API_KEY=
# Gemini (claim cross-checks, supplier category mapping)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Climatiq emission factors
CLIMATIQ_API_KEY=
# Electricity Maps grid intensity (region "GB" works without it via the UK National Grid API)
ELECTRICITY_MAPS_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact address
SEC_USER_AGENT="Aetheris Climate OS you@example.com"

# ---- Infrastructure (optional) ----
# Postgres: unset = in-memory store (data lost on restart). Tables are created automatically.
DATABASE_URL=
# Redis: unset = in-process cache
REDIS_URL=

# ---- Auth (optional) ----
# Any OIDC provider (Clerk, Auth0, Supabase, ...). When AUTH_JWKS_URL is set, write endpoints require
# a valid "Authorization: Bearer <JWT>". Unset = everyone is anonymous (local dev only).
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
